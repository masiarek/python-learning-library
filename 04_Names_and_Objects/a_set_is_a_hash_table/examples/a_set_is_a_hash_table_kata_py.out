 1. s1 | s2                                            {'a', 'b', 'c', 'd', 'e'}
 2. s1.intersection(s2)                                {'c'}
 3. s1 ^ s2                                            {'a', 'b', 'd', 'e'}
 4. len({True, 1, 1.0, '1'})                           2
 5. set((1, 2, 3)) & set((2, 3, 4)) & set((3, 4, 5))   {3}
 6. {1, 2, 3} ^ {3, 4, 5} ^ {5, 6, 7} ^ {7, 8, 1}      {2, 4, 6, 8}
 7. {1} ^ {1} ^ {1}                                    {1}
 8. s1 | ['z']                                         TypeError
 9. s1.union(['z'])                                    {'a', 'b', 'c', 'z'}
10. set().issubset([])                                 True
11. type({})                                           <class 'dict'>
